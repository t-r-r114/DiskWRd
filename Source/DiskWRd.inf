;
; DiskWRd.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = DiskWRd.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
DiskWRd.sys  = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%DiskWRd.DeviceDesc% = DiskWRd_Device, Root\DiskWRd ; TODO: edit hw-id

[DiskWRd_Device.NT]
CopyFiles = File_Copy

[File_Copy]
DiskWRd.sys

;-------------- Service installation
[DiskWRd_Device.NT.Services]
AddService = DiskWRd,%SPSVCINST_ASSOCSERVICE%, DiskWRd_Service_Inst

; -------------- DiskWRd driver install sections
[DiskWRd_Service_Inst]
DisplayName    = %DiskWRd.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\DiskWRd.sys

[DiskWRd_Device.NT.Wdf]
KmdfService = DiskWRd, DiskWRd_wdfsect

[DiskWRd_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "DiskWRd Installation Disk"
DiskWRd.DeviceDesc = "DiskWRd Device"
DiskWRd.SVCDESC = "DiskWRd Service"
